# Sighting provenance — kept locally, never committed
# Raw evidence images (waveforms/screenshots) referenced by records as provenance only
*.png
*.jpg
*.jpeg
*.gif
*.bmp

# Source mail / minutes (informal, may not be shareable) — data is folded into records instead
*.msg
*.eml

# Reference material / specs (provenance only, may not be shareable) — kept locally
*.pdf

# Python
__pycache__/
*.pyc

# Editor / tooling artifacts
.vscode/
